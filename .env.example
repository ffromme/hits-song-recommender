# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.
#
# Semua provider di bawah memakai format API "OpenAI-compatible", jadi cukup ganti 3 baris ini.
# Aktifkan SATU blok saja (hapus tanda # di depannya).

# --- Groq (disarankan untuk runtime/live: gratis, ±0,5 s/panggilan, 1.000 request/hari, 8.000 token/menit)
# Key: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b

# Opsional, berlaku untuk semua provider: kurangi waktu "berpikir" model agar lebih cepat (low/medium/high).
# LLM_REASONING_EFFORT=low

# --- Google Gemini (gratis 20 request/hari PER MODEL; dipakai untuk pelabelan awal katalog)
# Key: https://aistudio.google.com/apikey
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-3.5-flash

# --- OpenRouter (model berakhiran :free gratis, maks 50 request/hari, sering lambat). Key: https://openrouter.ai/keys
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<id-model>:free
