# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.
#
# Semua provider di bawah memakai format API "OpenAI-compatible", jadi cukup ganti 3 baris ini.
# Aktifkan SATU blok saja (hapus tanda # di depannya).

# --- Google Gemini (default, gratis). Key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# Opsional, berlaku untuk semua provider: kurangi waktu "berpikir" model agar lebih cepat (low/medium/high).
# LLM_REASONING_EFFORT=low

# --- Groq (gratis, sangat cepat). Key: https://console.groq.com/keys
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# --- OpenRouter (model berakhiran :free gratis, maks 50 request/hari). Key: https://openrouter.ai/keys
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=<id-model>:free
